# Réglages NON secrets de la production locale. Copier en `.env` pour les modifier :
#     cp .env.example .env
# Les secrets (mots de passe, sel de hachage, jeton du webhook, identifiants SMTP) ne vont
# JAMAIS ici : ils sont générés dans secrets/ par `python scripts/initialiser_secrets.py`.

# Ports publiés sur la machine hôte (127.0.0.1 uniquement). Valeurs choisies pour ne pas entrer
# en conflit avec un PostgreSQL (5432) ou un serveur web (8080) déjà installés.
PORT_AIRFLOW=18080
PORT_MLFLOW=15000
PORT_KAFKA=19092
PORT_POSTGRES=15432

# Journalisation : DEBUG, INFO, WARNING, ERROR.
FRAUDE_NIVEAU_JOURNAL=INFO

# Notification par courriel (canal « smtp ») : renseigner l'hôte, l'expéditeur et les destinataires
# (séparés par des virgules). L'identifiant et le mot de passe vont dans secrets/smtp_*.txt.
# TLS est exigé en production : le serveur doit proposer STARTTLS (port 587) ou TLS implicite (465).
FRAUDE_SMTP_HOTE=
FRAUDE_SMTP_PORT=587
FRAUDE_SMTP_EXPEDITEUR=
FRAUDE_SMTP_DESTINATAIRES=

# Notification par webhook (canal « webhook ») : l'URL HTTPS, qui contient souvent un jeton,
# va dans secrets/webhook_url.txt.
