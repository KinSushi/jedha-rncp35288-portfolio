# Serveur de suivi MLflow : base PostgreSQL pour les métadonnées, volume pour les artefacts.

FROM python:3.12-slim

ENV GIT_PYTHON_REFRESH=quiet \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

RUN pip install "mlflow==3.17.0" "psycopg2-binary>=2.9" \
    && useradd --uid 50000 --gid 0 --no-create-home --shell /usr/sbin/nologin mlflow \
    && mkdir -p /mlartifacts && chown -R 50000:0 /mlartifacts && chmod -R g=u /mlartifacts
USER 50000

EXPOSE 5000
