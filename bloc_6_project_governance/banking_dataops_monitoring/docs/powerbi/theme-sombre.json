{
  "name": "Banking DataOps - sombre",
  "dataColors": ["#3FDAD2", "#1A7197", "#FFBC9B", "#6B86B5", "#E0A03C", "#27C08D", "#FF5C5C", "#9DB0D2"],
  "background": "#161B26",
  "foreground": "#E6EDF3",
  "tableAccent": "#3FDAD2",
  "good": "#27C08D",
  "neutral": "#E0A03C",
  "bad": "#FF5C5C",
  "textClasses": {
    "label":  { "color": "#E6EDF3", "fontFace": "Segoe UI", "fontSize": 10 },
    "callout":{ "color": "#FFFFFF", "fontFace": "Segoe UI Semibold", "fontSize": 28 },
    "title":  { "color": "#3FDAD2", "fontFace": "Segoe UI Semibold", "fontSize": 13 },
    "header": { "color": "#E6EDF3", "fontFace": "Segoe UI Semibold", "fontSize": 11 }
  },
  "visualStyles": {
    "*": { "*": {
      "background": [{ "color": { "solid": { "color": "#161B26" } }, "transparency": 0 }],
      "border":     [{ "show": true, "color": { "solid": { "color": "#232A3A" } }, "radius": 6 }],
      "title":      [{ "show": true, "fontColor": { "solid": { "color": "#3FDAD2" } }, "background": { "solid": { "color": "#161B26" } }, "fontSize": 12 }]
    } },
    "page": { "*": {
      "background": [{ "color": { "solid": { "color": "#0E1117" } }, "transparency": 0 }],
      "outspace":   [{ "color": { "solid": { "color": "#0E1117" } } }]
    } }
  }
}
